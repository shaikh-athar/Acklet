# ==============================================================================
# Acklet / AirVault Cross-Device Sync & Networking Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Network / LAN Development (Connecting Mac/PC + Mobile phone on Wi-Fi)
# ------------------------------------------------------------------------------
# Server host & port binding:
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# CORS Allowed Origins (Comma-separated URLs):
# Add your local LAN IP (e.g. 192.168.1.50) so devices on the same Wi-Fi can connect
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://192.168.1.50:4200,http://localhost:3000

# Client Configuration:
# Set your machine's LAN IP when running Angular client:
# npm run start -- --host 0.0.0.0
# Angular will automatically serve at http://<YOUR_LAN_IP>:4200

# ------------------------------------------------------------------------------
# 2. Secure Tunnel / Remote Testing (ngrok / Cloudflare Tunnel)
# ------------------------------------------------------------------------------
# If running through an HTTPS tunnel:
# 1. Start tunnel: ngrok http 4200 (or ngrok http 8080 for backend)
# 2. Add tunnel domain to allowed origins:
# CORS_ALLOWED_ORIGINS=https://your-tunnel.ngrok-free.app,http://localhost:4200
# 3. Client will dynamically resolve WSS protocol (wss://your-tunnel.ngrok-free.app/ws/airvault)

# ------------------------------------------------------------------------------
# 3. Production Environment (HTTPS & WSS over Domain)
# ------------------------------------------------------------------------------
# SERVER_PORT=8080
# SERVER_ADDRESS=0.0.0.0
# CORS_ALLOWED_ORIGINS=https://app.acklet.com,https://acklet.com
# DB_URL=jdbc:postgresql://postgres-host:5432/acklet
# DB_USERNAME=acklet_prod
# DB_PASSWORD=your_secure_db_password
# REDIS_HOST=redis-prod.internal
# REDIS_PORT=6379
# JWT_SECRET=your_minimum_32_byte_production_secret_key_here
