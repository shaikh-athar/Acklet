# ====================================================
# Acklet Environment Variables Template (.env.example)
# Copy this file to .env and fill in required values
# ====================================================

# Profile (local / prod)
SPRING_PROFILES_ACTIVE=

# Database Credentials & Host
DB_HOST=
DB_PORT=
DB_NAME=
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Railway PostgreSQL Variables (Alternative)
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# Redis Configuration
REDIS_HOST=
REDIS_PORT=
REDIS_USER=
REDIS_PASSWORD=

# Railway Redis Variables (Alternative)
REDISHOST=
REDISPORT=
REDISUSER=
REDISPASSWORD=

# SMTP / Mail Configuration
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# RabbitMQ Configuration
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Application Security Keys (Mandatory)
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=
JWT_REFRESH_TOKEN_EXPIRATION=
APP_ENCRYPTION_KEY=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub Integration & Webhook Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# AI Provider API Keys & Model Parameters
MISTRAL_API_KEY=
MISTRAL_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_EXECUTOR_CORE=
AI_EXECUTOR_MAX=
AI_EXECUTOR_QUEUE=
