# ==========================================
# Acklet Unified Root .gitignore
# Standard ignores for Angular, Spring Boot & Docker
# ==========================================

# OS & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.history/
*.sublime-workspace
.project
.classpath
.settings/
.c9/
*.launch

# Node & Frontend (Angular Client)
node_modules/
**/node_modules/
dist/
**/dist/
.angular/
**/.angular/
.sass-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
connect.lock
coverage/
__screenshots__/

# Java & Backend (Spring Boot Server)
target/
**/target/
build/
**/build/
out/
**/out/
.gradle/
**/.gradle/
.mvn/wrapper/maven-wrapper.jar

# Logs & Temporary Files
*.log
tmp/
**/tmp/

# Environment & Local Secrets
.env
.env.*
!.env.example
*.local